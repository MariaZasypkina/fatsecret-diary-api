# FatSecret Platform API, OAuth 1.0a credentials from your developer app
# at https://platform.fatsecret.com (REST API OAuth 1.0 section).
FATSECRET_CONSUMER_KEY=
FATSECRET_CONSUMER_SECRET=

# User access token, obtained once via /api/auth/start after the
# consumer key and secret above are set.
FATSECRET_ACCESS_TOKEN=
FATSECRET_ACCESS_TOKEN_SECRET=

# Bearer token this API requires on every call. Pick any long random string.
API_BEARER_TOKEN=
